# =============================================================================
# .env.production.example — Variables de Entorno para Produccion
# =============================================================================
# COPIAR a .env y REEMPLAZAR todos los valores con credenciales reales.
# NUNCA hacer commit del archivo .env real (esta en .gitignore).
#
# Generar valores seguros:
#   SECRET_KEY:       openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -base64 24
# =============================================================================

# -----------------------------------------------------------------------------
# Base de Datos (PostgreSQL 16)
# -----------------------------------------------------------------------------
# ATENCION: Cambiar usuario y password por valores seguros.
# Dentro de Docker, el host es 'db' (nombre del servicio), NO 'localhost'.

POSTGRES_USER=app_prod_user
POSTGRES_PASSWORD=REEMPLAZAR-con-password-seguro-generado
POSTGRES_DB=tienda_mvp

# URL para SQLAlchemy async (FastAPI usa esta)
DATABASE_URL=postgresql+asyncpg://app_prod_user:REEMPLAZAR-con-password-seguro-generado@db:5432/tienda_mvp

# URL sincrona (migraciones, scripts, health checks)
DATABASE_URL_SYNC=postgresql://app_prod_user:REEMPLAZAR-con-password-seguro-generado@db:5432/tienda_mvp

# -----------------------------------------------------------------------------
# Backend API (FastAPI)
# -----------------------------------------------------------------------------

# Llave secreta para firmar tokens JWT.
# Generar con: openssl rand -hex 32
# CAMBIAR OBLIGATORIAMENTE. El valor por defecto de desarrollo NO es seguro.
SECRET_KEY=REEMPLAZAR-con-llave-segura-de-64-caracteres-hex

# Algoritmo de firma JWT (HS256 es seguro para single-service)
ALGORITHM=HS256

# Duracion del token de acceso en minutos (default: 480 = 8 horas)
# En produccion se recomienda un valor mas bajo: 60 (1 hora)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origenes permitidos para CORS.
# Lista de dominios separados por coma desde los cuales el frontend
# hara peticiones a la API. NO usar * en produccion.
# Ejemplo: https://tienda.midominio.com,https://admin.midominio.com
CORS_ORIGINS=https://tu-dominio.com

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------

# URL publica de la API a la que el frontend hara peticiones.
# Debe ser accesible desde el navegador del cliente.
# Si usas proxy reverso (Nginx), puede ser una ruta relativa como /api/v1
NEXT_PUBLIC_API_URL=https://tu-dominio.com/api/v1

# -----------------------------------------------------------------------------
# Opcional: Supabase (Storage de imagenes + Auth externa)
# -----------------------------------------------------------------------------
# Descomentar y configurar si usas Supabase para almacenamiento de imagenes
# o autenticacion externa. Si no usas Supabase, dejar comentado.

# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# SUPABASE_JWT_SECRET=tu-jwt-secret
# NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# =============================================================================
# ADVERTENCIAS DE SEGURIDAD
# =============================================================================
#
# 1. CAMBIA SECRET_KEY. Si usas el valor por defecto, cualquiera puede
#    falsificar tokens JWT y acceder al panel admin.
#
# 2. CAMBIA POSTGRES_PASSWORD. Credenciales debiles permiten acceso
#    no autorizado a la base de datos.
#
# 3. Usa POSTGRES_USER diferente a 'postgres' (cuenta de superadmin).
#
# 4. Nunca expongas el puerto 5432 al exterior. En docker-compose.prod.yml
#    ya esta configurado sin exposicion de puertos.
#
# 5. Configura HTTPS mediante un proxy reverso (Nginx, Caddy, Traefik).
#    No expongas los servicios directamente sobre HTTP en produccion.
#
# 6. CORS_ORIGINS debe contener SOLO los dominios de tu aplicacion.
#    No uses comodines (*) ni incluyas localhost.
#
# 7. Manten un backup automatizado de la base de datos.
#
# 8. NO compartas este archivo .env ni lo subas a sistemas de control
#    de versiones (GitHub, GitLab, etc.).
#
# =============================================================================
