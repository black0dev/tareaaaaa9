# =============================================================================
# Tienda de Camisetas MVP — Variables de Entorno
# =============================================================================
# Copiar este archivo a .env y ajustar valores según el entorno.
# NUNCA hacer commit del archivo .env (está en .gitignore).

# -----------------------------------------------------------------------------
# Base de Datos (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tienda_mvp
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tienda_mvp
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/tienda_mvp

# -----------------------------------------------------------------------------
# Backend API (FastAPI)
# -----------------------------------------------------------------------------
SECRET_KEY=cambiar-por-llave-segura-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Opcional: Supabase (para autenticación en producción)
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET=your-jwt-secret
